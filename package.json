{
  "name": "household-budget-workspace",
  "version": "2.0.0",
  "private": true,
  "description": "Local-first household budgeting workspace: spending drilldowns, usual-spend comparisons, budget planning and scenario forecasts. No runtime dependencies.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/build.cjs",
    "build:sample": "node tools/build.cjs --sample",
    "sample": "node tools/build-sample.cjs",
    "import": "node tools/import.cjs",
    "report": "node tools/plan-report.cjs",
    "report:sample": "node tools/plan-report.cjs --sample",
    "test": "node --test \"tests/unit/*.test.cjs\"",
    "test:browser": "node tools/build.cjs --sample --out dist/test/index.html && node tests/browser/run.cjs",
    "lint": "npx --yes eslint@9 src tools tests",
    "check:privacy": "node tools/check-privacy.cjs"
  }
}
